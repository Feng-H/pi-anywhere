{
  "name": "pi-anywhere",
  "version": "0.2.0",
  "description": "Native remote mobile Web Chat interface for Pi Coding Agent via Cloudflare Tunnel",
  "type": "module",
  "bin": {
    "pi-anywhere": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/public && cp -r src/public/* dist/public/",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "coding-agent",
    "remote",
    "mobile",
    "web-chat",
    "cloudflared",
    "tunnel"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "cloudflared": "^0.7.3",
    "commander": "^15.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}